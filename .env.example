# ── Backend ─────────────────────────────────────────────────────────────────────
# FastAPI base URL. NEXT_PUBLIC_* values are inlined at BUILD time: set them before `npm run build`.
# Used by the BFF (server), by the browser for direct file uploads, and to build the CSP connect-src.
NEXT_PUBLIC_API_BASE_URL=https://api.axioware.tech/v1
# Optional server-only override (runtime). Lets the BFF reach the API on a different/internal URL than the browser does.
# API_BASE_URL=

# ── Auth providers ──────────────────────────────────────────────────────────────
# Google *web* OAuth client ID: must equal the GOOGLE_WEB_CLIENT_ID the backend verifies ID tokens against.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=868978506069-nt3761atc0c8906tfnkubpgiskuhm3ih.apps.googleusercontent.com
# Sign in with Apple is hidden until BOTH are set (needs an Apple Services ID; see docs/auth.md).
NEXT_PUBLIC_APPLE_SERVICES_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=

# ── App ─────────────────────────────────────────────────────────────────────────
# Canonical origin of this app (used for the CSRF Origin check). Domain not purchased yet → localhost for dev.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
# "direct" (default): the browser uploads files straight to the backend (works on Vercel).
# "proxy": stream uploads through the BFF (browser never sees a token; needs a self-hosted Node server, not serverless).
# NEXT_PUBLIC_UPLOAD_MODE=direct

# ── Billing ─────────────────────────────────────────────────────────────────────
# Not wired yet; keep false (Upgrade buttons show "coming soon"). See docs/billing.md.
NEXT_PUBLIC_BILLING_ENABLED=false

# ── Runtime (server only; NOT a NEXT_PUBLIC_ build-time value) ──────────────────────
# How many trusted reverse proxies sit in front of the app. Rate limiting reads the client IP from X-Forwarded-For
# that many entries from the END (earlier entries can be forged). ALB only = 1 (default); CloudFront + ALB = 2.
# TRUSTED_PROXY_HOPS=2
