# Public: backend base URL (FastAPI). Used server-side by the BFF.
NEXT_PUBLIC_API_BASE_URL=https://api.axioware.tech/v1
# Public: same Google *web* OAuth client ID the backend verifies against.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=868978506069-nt3761atc0c8906tfnkubpgiskuhm3ih.apps.googleusercontent.com
# Public: canonical origin of this app (domain not purchased yet; localhost for dev).
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
# Apple Sign-In is stubbed until a Services ID exists. Set both to enable.
NEXT_PUBLIC_APPLE_SERVICES_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=
# Billing is not wired yet; keep false (Upgrade shows "coming soon").
NEXT_PUBLIC_BILLING_ENABLED=false
